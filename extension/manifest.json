{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "agente@firefox-mcp",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["nativeMessaging", "tabs", "webNavigation", "webRequest", "contextualIdentities", "cookies", "downloads", "<all_urls>"],
  "browser_action": {
    "default_title": "__MSG_badgeTitleActive__"
  },
  "sidebar_action": {
    "default_title": "__MSG_sidebarTitle__",
    "default_panel": "sidebar.html"
  },
  "background": {
    "scripts": ["security.js", "net.js", "page.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true,
      "js": ["console-hook.js"]
    }
  ],
  "experiment_apis": {
    "agentInput": {
      "schema": "experiments/input/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["agentInput"]],
        "script": "experiments/input/parent.js"
      }
    }
  }
}
